# Copy to `.env` and fill in. NEVER commit `.env` (it's git-ignored).
# Read by scripts/powerbi_client.py and scripts/acuitymd_client.py via the environment.

# ── Power BI (Microsoft Entra ID) ─────────────────────────────────────────────
PBI_TENANT_ID=
PBI_CLIENT_ID=
# Set PBI_CLIENT_SECRET for service-principal (unattended) auth.
# Leave it BLANK to use interactive device-code sign-in instead.
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=          # workspace (group) GUID; blank = My workspace
PBI_DATASET_ID=            # default semantic model for DAX queries

# ── AcuityMD (browser export — this org has NO API) ───────────────────────────
# Primary path. Prefer session reuse over storing a password: run headed once to
# complete SSO/MFA, and the session is saved to ~/.acuitymd_state.json.
ACUITYMD_EMAIL=
ACUITYMD_PASSWORD=         # optional if you log in interactively the first time
ACUITYMD_TERRITORY=        # default territory filter / saved-list name

# AcuityMD API (NOT available to this org — leave blank unless it gets enabled):
ACUITYMD_BASE_URL=
ACUITYMD_API_TOKEN=
ACUITYMD_CLIENT_ID=
ACUITYMD_CLIENT_SECRET=

# ── Command center (Netlify) ──────────────────────────────────────────────────
COMMAND_CENTER_URL=https://imsc-sales-command-center.netlify.app/
