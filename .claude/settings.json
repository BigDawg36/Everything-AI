{
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "claudex-loop": {
      "source": {
        "source": "github",
        "repo": "chaseai-yt/claudex-loop"
      }
    }
  },
  "enabledPlugins": {
    "watch@claude-video": true,
    "claudex-loop@claudex-loop": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
